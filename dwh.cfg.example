# Copy to dwh.cfg and fill in. Keep the single quotes on the [IAM_ROLE] and [S3] values.
# Keep the [CLUSTER] keys in this order: create_tables.py and etl.py read them by position.
[CLUSTER]
HOST=your-workgroup.123456789012.us-east-1.redshift-serverless.amazonaws.com
DB_NAME=dev
DB_USER=admin
DB_PASSWORD=your-password
DB_PORT=5439

[IAM_ROLE]
ARN='arn:aws:iam::123456789012:role/your-redshift-s3-role'

[S3]
LOG_DATA='s3://your-bucket/log-data'
LOG_JSONPATH='s3://your-bucket/log_json_path.json'
SONG_DATA='s3://your-bucket/song_data'
