# Copy to cluster.config (same folder) and fill in. Never commit cluster.config.
[AWS]
KEY=your-access-key-id
SECRET=your-secret-access-key

[DWH]
DWH_CLUSTER_TYPE=single-node
DWH_NUM_NODES=1
DWH_NODE_TYPE=ra3.large
DWH_CLUSTER_IDENTIFIER=dwh-cluster
DWH_DB=dev
DWH_DB_USER=admin
DWH_DB_PASSWORD=YourPassword123
DWH_PORT=5439

[IAM_ROLE]
NAME=dwhRedshiftS3Role
DESCRIPTION=Allows Redshift to read from S3
POLICY_ARN=arn:aws:iam::aws:policy/AmazonS3ReadOnlyAccess

[SECURITY_GROUP]
NAME=redshift-dwh-sg
DESCRIPTION=Inbound access to Redshift

[INBOUND_RULE]
TYPE=Redshift
PROTOCOL=TCP
PORT_RANGE=5439
CIDRIP=your.ip.address/32
DESCRIPTION=Allow my IP
